{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jrumandal/mf-orchestrator/repos.schema.json",
  "title": "mf-orchestrator repo registry",
  "type": "object",
  "required": ["version", "owner", "registry"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "registry": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "type", "publish", "dependsOn"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "type": { "enum": ["library", "mf", "gateway", "service", "host", "mobile"] },
          "description": { "type": "string" },
          "publish": { "type": "boolean" },
          "dependsOn": {
            "type": "array",
            "items": { "type": "string" }
          },
          "packages": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
