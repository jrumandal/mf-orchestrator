{
  "name": "@jrumandal/mf-orchestrator",
  "version": "0.0.1",
  "private": true,
  "description": "Cross-repo CI/CD orchestration for the micro-frontend platform (release ordering, version bumping, publish fan-out)",
  "type": "module",
  "scripts": {
    "topo": "node scripts/topo-sort.mjs",
    "topo:json": "node scripts/topo-sort.mjs --json",
    "bump": "node scripts/bump-version.mjs",
    "orchestrate": "node scripts/orchestrate.mjs",
    "validate": "node scripts/topo-sort.mjs && node scripts/orchestrate.mjs patch --dry-run"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.24.0"
}
